{
  "rules": {
    "rides": {
      "$rideId": {
        "riders": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['latitude', 'longitude', 'speed', 'lastUpdated'])",
            "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "speed": { ".validate": "newData.isNumber()" },
            "heading": { ".validate": "newData.isNumber()" },
            "name": { ".validate": "newData.isString()" },
            "lastUpdated": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
